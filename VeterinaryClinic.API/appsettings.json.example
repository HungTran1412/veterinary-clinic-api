{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=.;Database=VeterinaryClinicDb;User Id=sa;Password=your_password;MultipleActiveResultSets=true;TrustServerCertificate=True",
    "Redis": "localhost:6379,abortConnect=false"
  },
  "AppSettings": {
    "EnableCache": true
  },
  "CorsSettings": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "AdminSettings": {
    "Username": "admin",
    "Email": "admin@veterinaryclinic.com",
    "Password": "Abc@1234",
    "FullName": "System Administrator",
    "PhoneNumber": "0123456789"
  },
  "JwtSettings": {
    "Secret": "DayLaMotChuoiBiMatRatDaiVaPhucTapDeMaHoaJWT1234567890",
    "Issuer": "VeterinaryClinicAPI",
    "Audience": "VeterinaryClinicClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "EmailSettings": {
    "SmtpServer": "smtp.example.com",
    "SmtpPort": 587,
    "SmtpUser": "user@example.com",
    "SmtpPass": "password",
    "SenderName": "Veterinary Clinic",
    "SenderEmail": "noreply@veterinaryclinic.com",
    "ApiBaseUrl": "https://localhost:44360",
    "FrontendBaseUrl": "http://localhost:4200"
  },
  "CloudinarySettings": {
    "CloudName": "your_cloud_name",
    "ApiKey": "your_api_key",
    "ApiSecret": "your_api_secret"
  },
  "VnPaySettings": {
    "TmnCode": "your_tmn_code",
    "HashSecret": "your_hash_secret",
    "BaseUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "Command": "pay",
    "CurrCode": "VND",
    "Version": "2.1.0",
    "Locale": "vn",
    "ReturnUrl": "https://localhost:44360/veterinary-clinic/v1/payments/vnpay/return",
    "FrontendReturnUrl": "http://localhost:4200/payment/return",
    "ExpireMinutes": 15
  },
  "SignalR": {
    "Hubs": {
      "NotificationUrl": "/veterinary-clinic/v1/notifications/hub"
    }
  },
  "ClinicInfo": {
      "Name": "Phòng khám Thú y VetCare",
      "Address": "236 phố Ngô Xuân Quảng, xã Gia Lâm, thành phó Hà Nội",
      "PhoneNumber": "0123 456 789"
    }
}
